# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real secrets.

# ── App ────────────────────────────────────────────────────────────────────────

PORT=8080

# Password for the admin dashboard (/admin) — create/revoke upload links and
# view the audit log. This is the only account in the whole app.
ADMIN_PASSWORD=

# Max size of a single encrypted upload, in MB. Files are zipped and
# AES-256-GCM encrypted in the browser before upload, so this caps the
# ciphertext size (close to the original file size).
MAX_UPLOAD_MB=50

# How long a file stays available for retry after a download is first
# triggered, before it's permanently deleted regardless of whether the
# transfer finished.
DOWNLOAD_GRACE_MINUTES=5

# Comma-separated list of allowed CORS origins.
# Only needed if the frontend is served from a different origin than the API
# (local dev already defaults to localhost:5173 / :3000).
CORS_ORIGINS=

# ── CapRover deployment ─────────────────────────────────────────────────────────
# Used by scripts/scaffold.sh and scripts/sync-secrets.sh.
# Not injected into the running app.

# URL of your CapRover instance, e.g. https://captain.your-domain.com
# Must match an active session in the caprover CLI (run: caprover login)
CAPROVER_URL=

# CapRover admin password — only needed so sync-secrets.sh can push it to
# GitHub Secrets for use by CI. Not used by local scripts directly.
CAPROVER_PASSWORD=

# Name of the production app in CapRover, e.g. myapp
CAPROVER_APP=myapp

# Domain suffix for preview apps, e.g. your-domain.com
# Preview apps will be reachable at <branch-name>.<CAPROVER_APP_DOMAIN>
CAPROVER_APP_DOMAIN=

# ── Private GHCR (image pull auth for CapRover) ────────────────────────────────
# Required for CapRover to pull private Docker images built by CI.
# GITHUB_OWNER: your GitHub username or org
# GHCR_TOKEN: a Personal Access Token with read:packages scope
#   Create at: https://github.com/settings/tokens

GITHUB_OWNER=
GHCR_TOKEN=
