# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real secrets.

# ── App ────────────────────────────────────────────────────────────────────────

PORT=8080

# JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── OAuth (optional — leave blank to disable) ──────────────────────────────────

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Base URL for OAuth redirect URIs (no trailing slash)
#   Production: https://myapp.your-domain.com
#   Local (if testing OAuth against built app): http://localhost:8080
OAUTH_CALLBACK_BASE=

# Where to send users after OAuth completes
#   Production: leave empty (defaults to /auth/callback on same origin)
#   Local with Vite on 5173: http://localhost:5173/auth/callback
OAUTH_REDIRECT_URL=

# ── CapRover deployment ─────────────────────────────────────────────────────────
# Used by scripts/scaffold.sh and scripts/sync-secrets.sh.
# Not injected into the running app.

# URL of your CapRover instance, e.g. https://captain.your-domain.com
# Must match an active session in the caprover CLI (run: caprover login)
CAPROVER_URL=

# CapRover admin password — only needed so sync-secrets.sh can push it to
# GitHub Secrets for use by CI. Not used by local scripts directly.
CAPROVER_PASSWORD=

# Name of the production app in CapRover, e.g. myapp
CAPROVER_APP=myapp

# Domain suffix for preview apps, e.g. your-domain.com
# Preview apps will be reachable at <branch-name>.<CAPROVER_APP_DOMAIN>
CAPROVER_APP_DOMAIN=

# ── Private GHCR (image pull auth for CapRover) ────────────────────────────────
# Required for CapRover to pull private Docker images built by CI.
# GITHUB_OWNER: your GitHub username or org
# GHCR_TOKEN: a Personal Access Token with read:packages scope
#   Create at: https://github.com/settings/tokens

GITHUB_OWNER=
GHCR_TOKEN=

# Seeded admin accounts — JSON array of {email, password} objects.
# On every startup the server upserts these accounts with is_admin=1 and
# removes admin from any account no longer present in this list.
# Use your encrypted .env.local to keep credentials out of source control.
#
# Example (single admin):
#   ADMIN_USERS=[{"email":"admin@example.com","password":"change-me-before-use"}]
ADMIN_USERS=
